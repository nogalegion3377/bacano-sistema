{
  "name": "pizza-bacano",
  "productName": "Pizza Bacano",
  "version": "1.0.0",
  "description": "Sistema de la pizzería Bacano: comandas, mercadería, clientes y caja",
  "author": "Agustín Cisneros",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "instalador": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "ar.bacano.sistema",
    "productName": "Pizza Bacano",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "pantallas/**/*", "build/icon.png"],
    "win": { "target": "nsis", "icon": "build/icon.png", "signAndEditExecutable": false },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pizza Bacano",
      "artifactName": "Instalar-Pizza-Bacano.exe"
    }
  }
}
